package q3;

public class Funcionario {
 String nome;
 String cargo;
 double salario;

	Funcionario(String nome,String cargo, float salario){
		this.nome = nome;
		this.cargo = cargo;
		this.salario = salario;
	}
	
	Funcionario(String nome){
		this.nome = nome;
		this.cargo = "Não informado";
		this.salario = 0.0;
	}
	Funcionario(){
		this.nome = "Não informado";
		this.cargo = "Não informado";
		this.salario = 0.0;
	}
	
	void aumentarSalario(double percentual) {
		this.salario += this.salario*(percentual/100);
	}
	void aumentarSalario(double percentual, double bonus) {
		this.salario += this.salario*(percentual/100)+ bonus;
	}
	
	void exibirDados() {
		System.out.println("Nome: " + this.nome + "\n" +
						   "Cargo: " + this.cargo + "\n" +
						   "Salário: " + this.salario + "\n" +
						   "-------------------------------"
							);
	}
}
